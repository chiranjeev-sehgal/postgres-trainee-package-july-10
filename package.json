{
  "name": "debugging-olympics-postgresql",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:visible",
    "test:visible": "jest --runInBand tests/visible",
    "test:hidden": "jest --runInBand instructor/hidden-tests",
    "test:all": "npm run test:visible && npm run test:hidden",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "evaluate": "tsx instructor/score-submission.ts",
    "package:trainee": "sh scripts/package-trainee.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.15.0",
    "pg": "^8.12.0",
    "prisma": "^5.18.0",
    "testcontainers": "^10.10.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
